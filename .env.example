# Copy to .env and fill in. Never commit .env. Credentials load from environment only.

# --- Database (PostGIS) ---
DATABASE_URL=postgresql://territorio_ro:CHANGE_ME@localhost:5434/territorio

# --- NVIDIA build (token layer) — OpenAI-compatible endpoint ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_PLANNER=nvidia/nemotron-3-super-120b-a12b     # id confirmed 2026-09-26 (docs.api.nvidia.com/nim/reference)
MODEL_WORKER=nvidia/nemotron-3.5-lightning-30b-a3b  # probed 2026-09-27: HTTP 200 (nemotron-3-nano-30b-a3b → 410 retired; see docs/lessons.md)

# --- Zetaris (data layer) — MCP over Streamable HTTP ---
ZETARIS_MCP_URL=https://dataharness.CLUSTER.ORG.cloud.zetaris.com:8009/mcp
ZETARIS_MCP_TOKEN=

# --- External open APIs ---
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=territorio-explicado (contact: your@email)
IPMA_RCM_URL=https://api.ipma.pt/open-data/forecast/meteorology/rcm/rcm-d0.json

# --- Runtime ---
PORT=3000
LOG_LEVEL=info
SAMPLE_MODE=false   # true = sample extract + replay of recorded real runs, no external calls; labelled as replays
